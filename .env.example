# ============================================================
# StormFusion AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---------- Application Mode ----------
# Options: DEMO | LIVE
# DEMO = fully offline with synthetic data
# LIVE = attempts to use real data sources, falls back to DEMO per-source
STORMFUSION_MODE=DEMO

# ---------- MOSDAC Credentials ----------
# Required only in LIVE mode for satellite data download.
# Get credentials from: https://mosdac.gov.in
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ---------- Data Directories ----------
# Where downloaded and processed data is stored locally.
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SYNTHETIC_DATA_DIR=./data/synthetic

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true

# ---------- Database ----------
# For prototype, SQLite is used. Path to the .db file:
DATABASE_URL=sqlite:///./data/stormfusion.db

# When migrating to PostgreSQL/PostGIS later, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/stormfusion

# ---------- Logging ----------
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- Region of Interest (default) ----------
# Bounding box for default data queries [west, south, east, north]
DEFAULT_BBOX=68.0,6.0,98.0,38.0

# ---------- Forecast Lead Times (minutes) ----------
FORECAST_LEAD_TIMES=15,30,60,90

# ---------- Frontend (if needed) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
