# ============================================================
# StormFusion AI — .gitignore
# ============================================================

# ---------- Environment & Secrets ----------
.env
.env.local
.env.production
config.json
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/build/
.next/
*.tsbuildinfo

# ---------- Data (never commit raw/processed data) ----------
data/raw/
data/processed/
data/downloads/
*.h5
*.hdf5
*.nc
*.nc4
*.grib
*.grib2
*.tif
*.tiff
*.geotiff

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
logs/
*.log

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Model artifacts ----------
models/checkpoints/
models/exports/
*.pt
*.pth
*.onnx
wandb/
mlruns/
